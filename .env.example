# Copy this file to .env and adjust values. Never commit the real .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=terrainx
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_DB=terrainx
POSTGRES_PORT=5432
# Used by the backend/worker (async SQLAlchemy, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://terrainx:change-me-dev-password@db:5432/terrainx
# Used by Alembic migrations (sync psycopg driver)
DATABASE_URL_SYNC=postgresql+psycopg://terrainx:change-me-dev-password@db:5432/terrainx

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0
# R1: report work has an explicit RQ execution limit. Stale reconciliation
# must remain above that limit so an active work horse is never falsely failed.
REPORT_GENERATION_TIMEOUT_SECONDS=900
STALE_REPORT_AFTER_SECONDS=1200

# --- Backend ---
# The documented JWT value below is for local development only. Any shared,
# staging, or production deployment must set ENVIRONMENT to a non-development
# value and replace JWT_SECRET_KEY with its own secret; startup rejects this
# example value outside development.
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
JWT_SECRET_KEY=change-me-to-a-long-random-value-in-real-envs
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Path inside the backend/worker containers; bind-mounted from ../storage on
# the host so uploaded files survive container restarts/recreation.
STORAGE_ROOT=/app/storage/data
MAX_UPLOAD_SIZE_MB=500

# --- Test isolation (backend pytest ONLY) ---
# MUST resolve to a different database/storage root than DATABASE_URL/
# STORAGE_ROOT above — backend/tests/conftest.py refuses to run any test
# otherwise. The test suite's own cleanup fixture deletes everything it
# touches after every test, so it must never be able to resolve to real
# development data. Same credentials/host as above, just a distinct
# database name and storage subdirectory.
TEST_DATABASE_URL=postgresql+asyncpg://terrainx:change-me-dev-password@db:5432/terrainx_test
TEST_DATABASE_URL_SYNC=postgresql+psycopg://terrainx:change-me-dev-password@db:5432/terrainx_test
TEST_STORAGE_ROOT=/app/storage/test_data
# A different Redis DB index (same Redis server) than REDIS_URL above — real
# analysis/report jobs flow through an RQ queue backed by Redis, and without
# this the real development `worker` container and the test suite's own
# worker (backend/tests/conftest.py) race on the SAME queue, each able to
# steal the other's jobs.
TEST_REDIS_URL=redis://redis:6379/1
# Depth estimation rejects source images wider or taller than this (px) —
# bounds memory use for large remote-sensing imagery.
MAX_DEPTH_INPUT_DIMENSION_PX=4096
# Phase 4 metric calibration (DEM/GCP) — see docs/ARCHITECTURE.md.
CALIBRATION_MAX_SAMPLES=2000
MIN_CALIBRATION_SAMPLES=3
CALIBRATION_OUTLIER_SIGMA=2.5
CALIBRATION_MAX_ITERATIONS=5
MIN_GCP_POINTS=3
# P1-2 calibration quality gate — engineering acceptance-policy settings, NOT
# empirically validated accuracy standards (see docs/ARCHITECTURE.md §3.4).
CALIBRATION_MIN_CV_SKILL=0.0
CALIBRATION_CV_BLOCKS_PER_SIDE=4
CALIBRATION_QUALITY_POLICY_VERSION=v1
# P1-3 raster bare-earth approximation (DTM/nDSM estimates) — literature-default
# engineering parameters, NOT validated for monocular surfaces (see
# docs/ARCHITECTURE.md §3.12).
GROUND_FILTER_MAX_WINDOW_M=20
GROUND_FILTER_SLOPE=0.15
GROUND_FILTER_INITIAL_THRESHOLD=0.5
GROUND_FILTER_MAX_THRESHOLD=3.0
GROUND_FILTER_POLICY_VERSION=v1
# Phase 5 visualization — see docs/ARCHITECTURE.md §3.5.
PREVIEW_MAX_DIMENSION=1024
MAX_TERRAIN_DIMENSION=256

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
# How often the UI polls for analysis job status while a job is queued/running.
VITE_ANALYSIS_POLL_INTERVAL_MS=3000
# Phase 5 2D map basemap (OpenStreetMap by default for dev) — never a
# hardcoded commercial API key; swap for a licensed provider's URL/attribution
# in production via this env var, not by editing source.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
